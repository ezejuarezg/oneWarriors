---
import Layout from '../layouts/Layout.astro';
import HeroContent from '../components/HeroContent';
import Entrenamiento from '../components/Training';
import SobreMi from '../components/AboutMe';
import FAQ from '../components/Faq';
import Contacto from '../components/Contact';
import Footer from '../components/Footer.astro';
---

<Layout
  pageTitle="One Warrior | Facu Vargas"
  description="Kickboxing, Muay Thai y musculación con clases personalizadas en Chascomús."
  path="/"
>
  <main>
    <HeroContent client:load />
    <Entrenamiento client:visible />
    <SobreMi client:visible />
    <FAQ client:visible />
    <Contacto client:visible />
  </main>
  <Footer />
</Layout>